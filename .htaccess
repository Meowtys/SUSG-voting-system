Options -Indexes

<FilesMatch "^(?:\.env|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|README(?:\..*)?)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
